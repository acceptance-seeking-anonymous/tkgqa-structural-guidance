# Copy to configs/llm.env, fill in, and export LLM_CONFIG=configs/llm.env (or export the variables directly).
# Chat-completions endpoint (/v1/chat/completions interface) used for the R1 rewrite generator and the LLM judge (R1, R2).
LLM_API_BASE=http://localhost:8000/v1
LLM_API_KEY=
# Model IDs of the generator and the judge: use the IDs reported in the paper.
GEN_MODEL_ID=<SET_TO_MODEL_ID_REPORTED_IN_PAPER>
JUDGE_MODEL_ID=<SET_TO_MODEL_ID_REPORTED_IN_PAPER>
# Optional sampling temperature (unset = provider default).
LLM_TEMPERATURE=
# R3 generator (Google Gemini API, model gemini-2.5-pro; amendment A1 of the R3 rule): API key.
GEMINI_API_KEY=
