# Copy to configs/paths.env, edit, and `source configs/paths.env` before running scripts/ or any GPU-host script.
# All scripts read paths only from these variables; nothing outside the repository is referenced otherwise.
export DATA_DIR=/path/to/MultiTQ/data/MultiTQ        # MultiTQ release folder with kg/ and questions/ (and its SHA256SUMS)
export MTQ_DIR=/path/to/project_root                  # project root on the GPU host: holds kpct/ (= WORK_DIR) and phase1_structural/
export WORK_DIR=$MTQ_DIR/kpct                         # k% work tree on the GPU host (bundles, preds, executor, guided, parser, k0, ...)
export MODEL_DIR=/path/to/hf_cache                    # Hugging Face cache with the base models (mounted read-only as /hf)
export OUT_DIR=/path/to/outputs                       # local outputs of the CPU stages (subsets, structural retraining, analyses)
export SWORK=$OUT_DIR/kpct_structural                 # local structural k% tree (stages 1-3)
export CRON_DATA=/path/to/cronquestions_data          # CronQuestions data folder (cronquestions/ only)
# second GPU host (parser LoRA-seed replications 1-2 only)
export WORK_DIR_B=/path/to/work_dir_on_second_host
export SCRATCH_B=/path/to/scratch_on_second_host
# docker images built from environment/ (tags are free to choose)
export GPU_IMAGE=tkgqa-gpu:latest
export VLLM_IMAGE=tkgqa-vllm:latest
